<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F4EA"
    android:fitsSystemWindows="true">

    <fragment
        android:id="@+id/arFragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Верхняя панель с подсказками -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_panel_rounded"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ШАГ 1 ИЗ 5"
            android:textColor="#263D2C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Наведите прицел на основание (корни) дерева"
            android:textColor="#17291D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Поиск плоскости..."
            android:textColor="#59604F"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Прицел в центре экрана -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Вертикальная линия прицела -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="#263D2C" />
        
        <!-- Горизонтальная линия прицела -->
        <View
            android:layout_width="24dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="#263D2C" />

        <!-- Плавающий текст с результатами (прямо над прицелом) -->
        <TextView
            android:id="@+id/tvRealtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:translationY="-50dp"
            android:background="@drawable/bg_panel_rounded"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="0.00 м"
            android:textColor="#17291D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Нижняя панель кнопок -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:weightSum="4"
        android:background="@drawable/bg_panel_rounded"
        android:padding="10dp"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btnUndo"
            android:contentDescription="Отменить предыдущую точку"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_weight="1"
            android:backgroundTint="#DCE7B8"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#17291D" />

        <Button
            android:id="@+id/btnPlace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_weight="3"
            android:layout_marginStart="10dp"
            android:backgroundTint="#263D2C"
            android:textColor="#FFFFFF"
            android:text="Зафиксировать"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>