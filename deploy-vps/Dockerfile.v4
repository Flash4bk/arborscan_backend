# A fresh image is gated separately from the exact-runtime overlay.
ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE}
ARG PYTHON_BASE_IMAGE
RUN python -c "import os,re,sys; assert re.fullmatch(r'python:3\.11\.16-slim-bookworm@sha256:[a-f0-9]{64}',os.environ['PYTHON_BASE_IMAGE']); assert sys.version_info[:3]==(3,11,16)"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/arborscan

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deploy-vps/requirements.v4.txt /tmp/requirements.v4.txt
COPY deploy-vps/requirements.runtime-v4.lock.txt /tmp/requirements.runtime-v4.lock.txt

# CPU-only VPS.  Installing the CPU wheel first prevents a CUDA-heavy runtime.
RUN python -m pip install --upgrade pip==26.2.1 setuptools==84.0.0 wheel==0.48.0 \
    && python -m pip install \
        --index-url https://download.pytorch.org/whl/cpu \
        --no-deps torch==2.14.0+cpu torchvision==0.29.0+cpu \
    && python -m pip install --no-deps -r /tmp/requirements.v4.txt \
    && python -m pip check \
    && python -c "import importlib.metadata as m,cv2,numpy,torch,torchvision,ultralytics,fastapi,PIL; assert torch.version.cuda is None; assert not any(d.metadata['Name'].lower()=='opencv-python-headless' for d in m.distributions())"

RUN groupadd --gid 1000 arborscan \
    && useradd \
        --uid 1000 \
        --gid 1000 \
        --create-home \
        --shell /usr/sbin/nologin \
        arborscan

COPY --chown=arborscan:arborscan config.py /app/config.py
COPY --chown=arborscan:arborscan arborscan_v4 /app/arborscan_v4
COPY --chown=arborscan:arborscan arborscan_science /app/arborscan_science

USER arborscan

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=8).read()" || exit 1

CMD ["python", "-m", "uvicorn", "arborscan_v4.api:app", \
     "--host", "0.0.0.0", \
     "--port", "8001", \
     "--workers", "1", \
     "--proxy-headers", \
     "--forwarded-allow-ips=*"]
