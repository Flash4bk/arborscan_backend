FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/arborscan

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deploy-vps/requirements.v4.txt /tmp/requirements.v4.txt

# CPU-only VPS.  Installing the CPU wheel first prevents a CUDA-heavy runtime.
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install \
        --index-url https://download.pytorch.org/whl/cpu \
        torch torchvision \
    && python -m pip install -r /tmp/requirements.v4.txt

RUN groupadd --gid 1000 arborscan \
    && useradd \
        --uid 1000 \
        --gid 1000 \
        --create-home \
        --shell /usr/sbin/nologin \
        arborscan

COPY --chown=arborscan:arborscan config.py /app/config.py
COPY --chown=arborscan:arborscan arborscan_v4 /app/arborscan_v4

USER arborscan

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=8).read()" || exit 1

CMD ["python", "-m", "uvicorn", "arborscan_v4.api:app", \
     "--host", "0.0.0.0", \
     "--port", "8001", \
     "--workers", "1", \
     "--proxy-headers", \
     "--forwarded-allow-ips=*"]
