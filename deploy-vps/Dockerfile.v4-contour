# Rollout on the exact existing runtime: no dependency or model upgrades.
# Pass the recorded running image ID/tag explicitly; there is no floating default.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --chown=arborscan:arborscan config.py /app/config.py
COPY --chown=arborscan:arborscan arborscan_v4 /app/arborscan_v4
